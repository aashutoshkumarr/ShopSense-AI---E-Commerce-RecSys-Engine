# ==============================================================================
# ShopSense AI - Production Environment Configuration
# ==============================================================================

# Server Runtime
NODE_ENV=production
PORT=3000

# PostgreSQL Database (with pgvector extension)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shopsense

# Redis In-Memory Cache & Keyspace
REDIS_URL=redis://localhost:6379

# Security & Authentication
JWT_SECRET=super_secret_production_jwt_signing_key_at_least_32_characters_long

# Optional Gemini GenAI Orchestration Key
GEMINI_API_KEY=your_gemini_api_key_here
